<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3300E5FF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#262A527A"
                android:centerColor="#22173452"
                android:endColor="#3300C6FF"
                android:type="linear" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.2dp"
                android:color="#6600E5FF" />
        </shape>
    </item>
</ripple>
