<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_premium_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvChooserTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose Media"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Edit a Video or a Photo with this tool"
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPickVideoOpt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_primary_gradient_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Video"
            android:textColor="#04101D"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPickPhotoOpt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_white_pill_cta"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Photo"
            android:textColor="#1854D6"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
