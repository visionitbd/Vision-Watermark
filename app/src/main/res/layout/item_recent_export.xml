<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Rounded Thumbnail with Duration Pill -->
    <FrameLayout
        android:layout_width="112dp"
        android:layout_height="76dp">

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#08101E"
            android:contentDescription="Video thumbnail"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_thumb_gradient" />

        <TextView
            android:id="@+id/tvDurationBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="5dp"
            android:background="@drawable/bg_thumb_badge"
            android:fontFamily="monospace"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Title + Clean Metadata Pills -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSizeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_button"
                android:fontFamily="monospace"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="0.0 MB"
                android:textColor="@color/cyan_accent"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="HD MP4"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Premium Gradient Play + Glass Share Buttons -->
    <ImageButton
        android:id="@+id/btnPlayItem"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_primary_gradient_btn"
        android:contentDescription="@string/play"
        android:padding="9dp"
        android:src="@drawable/ic_play" />

    <ImageButton
        android:id="@+id/btnShareItem"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_circle_icon_btn"
        android:contentDescription="@string/share"
        android:padding="9dp"
        android:src="@drawable/ic_share" />

</LinearLayout>
