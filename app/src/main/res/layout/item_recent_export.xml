<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="92dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Rounded Video Thumbnail with Duration Pill -->
    <FrameLayout
        android:layout_width="124dp"
        android:layout_height="72dp">

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#08101E"
            android:contentDescription="Video thumbnail"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_thumb_gradient" />

        <TextView
            android:id="@+id/tvDurationBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="5dp"
            android:background="@drawable/bg_thumb_badge"
            android:fontFamily="monospace"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Clean Centered File Size Pill Only (Zero Title / Zero HD MP4 clutter!) -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/tvSizeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:background="@drawable/bg_pill_button"
            android:fontFamily="monospace"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="0.0 MB"
            android:textColor="@color/cyan_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Premium Gradient Play + Glass Share Buttons -->
    <ImageButton
        android:id="@+id/btnPlayItem"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_primary_gradient_btn"
        android:contentDescription="@string/play"
        android:padding="10dp"
        android:src="@drawable/ic_play" />

    <ImageButton
        android:id="@+id/btnShareItem"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_circle_icon_btn"
        android:contentDescription="@string/share"
        android:padding="10dp"
        android:src="@drawable/ic_share" />

</LinearLayout>
