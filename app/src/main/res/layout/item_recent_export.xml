<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <!-- Compact Rounded Thumbnail with Duration Pill -->
    <FrameLayout
        android:layout_width="108dp"
        android:layout_height="68dp">

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#08101E"
            android:contentDescription="Video thumbnail"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_thumb_gradient" />

        <TextView
            android:id="@+id/tvDurationBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:background="@drawable/bg_thumb_badge"
            android:fontFamily="monospace"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Single-Line Compact MB Pill -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingHorizontal="10dp">

        <TextView
            android:id="@+id/tvSizeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:background="@drawable/bg_pill_button"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="0.0 MB"
            android:textColor="@color/cyan_accent"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Compact Sleek Play & Share Buttons -->
    <ImageButton
        android:id="@+id/btnPlayItem"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_primary_gradient_btn"
        android:contentDescription="@string/play"
        android:padding="8dp"
        android:src="@drawable/ic_play" />

    <ImageButton
        android:id="@+id/btnShareItem"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_circle_icon_btn"
        android:contentDescription="@string/share"
        android:padding="8dp"
        android:src="@drawable/ic_share" />

</LinearLayout>
